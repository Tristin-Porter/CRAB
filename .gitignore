.vs/
bin/
obj/
TestProject/
testing/

# Allow tests/ folder with test files, but ignore specific test output folders
!tests/
tests/*_outputs/
tests/HelloWorld/
tests/Calculator/
tests/ClassHierarchy/
tests/GenericCollections/

*_outputs/

# Test command generated projects (at root level only)
/HelloWorld/
/Calculator/
/ClassHierarchy/
/GenericCollections/

# Allow Examples directory but ignore their bin/obj folders
!Examples/
Examples/*/bin/
Examples/*/obj/
