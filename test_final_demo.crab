class Demo {
    // Test 1: Simple return with literal
    int GetFive() {
        return 5;
    }
    
    // Test 2: Void return
    void DoNothing() {
        return;
    }
    
    // Test 3: Hex literal
    int GetHex() {
        return 0xFF;
    }
    
    // Test 4: Boolean literals
    bool GetTrue() {
        return true;
    }
    
    bool GetFalse() {
        return false;
    }
}
