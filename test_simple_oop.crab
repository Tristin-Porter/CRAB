// Simple C# feature test for CRAB compiler
// Tests var declarations and basic OOP

using System;

// Basic class with fields and methods
class Calculator
{
    private int value;
    
    public Calculator(int initial)
    {
        value = initial;
    }
    
    public int Add(int amount)
    {
        value = value + amount;
        return value;
    }
    
    public int GetValue()
    {
        return value;
    }
}

// Test var declarations
class VarTest
{
    public int TestVar()
    {
        // var with integer literal
        var x = 10;
        var y = 20;
        var sum = x + y;
        
        return sum;
    }
}

// Test inheritance
class Base
{
    protected int baseValue;
    
    public Base(int val)
    {
        baseValue = val;
    }
    
    public virtual int GetValue()
    {
        return baseValue;
    }
}

class Derived : Base
{
    private int derivedValue;
    
    public Derived(int b, int d) : base(b)
    {
        derivedValue = d;
    }
    
    public override int GetValue()
    {
        return baseValue + derivedValue;
    }
}

// Entry point
class Program
{
    static void Main()
    {
        // Test calculator
        var calc = new Calculator(0);
        calc.Add(10);
        calc.Add(20);
        var result = calc.GetValue();
        
        // Test var
        var varTest = new VarTest();
        var varResult = varTest.TestVar();
        
        // Test inheritance
        var derived = new Derived(100, 50);
        var total = derived.GetValue();
    }
}
