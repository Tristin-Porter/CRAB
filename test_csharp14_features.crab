// CRAB Compiler - Comprehensive C# 14 Feature Test
// This file demonstrates support for C# 14 language features

using System;

// C# 12: Primary constructors for classes
class Point(int x, int y)
{
    public int X { get; } = x;
    public int Y { get; } = y;
    
    public int Distance()
    {
        return X * X + Y * Y;
    }
}

// C# 12: Primary constructors for structs
struct Vector(double x, double y)
{
    public double X { get; } = x;
    public double Y { get; } = y;
}

// Traditional class with inheritance and polymorphism
abstract class Shape
{
    public abstract int Area();
    public virtual int Perimeter()
    {
        return 0;
    }
}

class Rectangle : Shape
{
    private int width;
    private int height;
    
    public Rectangle(int w, int h)
    {
        width = w;
        height = h;
    }
    
    public override int Area()
    {
        return width * height;
    }
    
    public override int Perimeter()
    {
        return 2 * (width + height);
    }
}

// Interface with default implementation (C# 8)
interface IDrawable
{
    void Draw();
    
    // Default implementation
    void Highlight()
    {
        Draw();
    }
}

// C# 11: Static abstract members in interfaces
interface IMathOperations<T>
{
    static abstract T Add(T a, T b);
    static abstract T Zero { get; }
}

// Generic class implementing interface
class Calculator<T> where T : struct
{
    public T Add(T a, T b)
    {
        // Generic operations would need runtime support
        return a;
    }
}

// C# 3: var declarations
class VarExample
{
    public void TestVar()
    {
        // var with implicit typing
        var number = 42;
        var text = "Hello";
        var isValid = true;
        
        // var with object creation
        var point = new Point(10, 20);
        var distance = point.Distance();
    }
}

// C# 9: Records
record Person(string Name, int Age);

record Employee(string Name, int Age, string Department) : Person(Name, Age);

// C# 12: Collection expressions
class Collections
{
    public void TestCollections()
    {
        // Collection expressions
        var numbers = [1, 2, 3, 4, 5];
        var empty = [];
    }
}

// Delegates and lambdas
delegate int MathOperation(int a, int b);

class DelegateExample
{
    public void TestDelegates()
    {
        // Lambda expression
        MathOperation add = (a, b) => a + b;
        MathOperation multiply = (a, b) => a * b;
        
        var result1 = add(5, 3);
        var result2 = multiply(5, 3);
    }
}

// C# 12: Lambda default parameters
class LambdaDefaults
{
    public void TestLambdaDefaults()
    {
        var increment = (int x, int step = 1) => x + step;
        var result1 = increment(10);      // 11
        var result2 = increment(10, 5);   // 15
    }
}

// C# 12: ref readonly parameters
class RefReadonly
{
    public int Calculate(ref readonly int value)
    {
        return value * 2;
    }
}

// C# 12: Using alias for any type
using StringList = System.Collections.Generic.List<string>;
using IntPair = (int, int);

class AliasExample
{
    public void TestAliases()
    {
        // StringList list = new StringList();
        IntPair pair = (1, 2);
    }
}

// Pattern matching
class PatternExample
{
    public int TestPattern(object obj)
    {
        return obj switch
        {
            int i => i,
            string s => s.Length,
            Point p => p.X + p.Y,
            _ => 0
        };
    }
}

// Entry point
class Program
{
    static void Main()
    {
        // Test var declarations
        var example = new VarExample();
        example.TestVar();
        
        // Test OOP - inheritance and polymorphism
        Shape rect = new Rectangle(10, 20);
        var area = rect.Area();
        var perimeter = rect.Perimeter();
        
        // Test generics
        var calc = new Calculator<int>();
        var sum = calc.Add(5, 10);
        
        // Test delegates
        var delegateTest = new DelegateExample();
        delegateTest.TestDelegates();
        
        // Test records
        var person = new Person("Alice", 30);
        var employee = new Employee("Bob", 25, "Engineering");
    }
}
