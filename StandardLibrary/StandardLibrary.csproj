<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CRAB.StandardLibrary</RootNamespace>
    <AssemblyName>CRAB.StandardLibrary</AssemblyName>
    <Description>CRAB Standard Library - Basic functionality for CRAB compiled programs</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude example files from compilation -->
    <Compile Remove="Examples/**/*.cs" />
    <None Include="Examples/**/*.cs" />
  </ItemGroup>

</Project>
