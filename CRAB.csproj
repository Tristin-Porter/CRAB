<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test files from compilation -->
    <Compile Remove="Testing/**/*.cs" />
    <None Include="Testing/**/*.cs" />
    
    <!-- Exclude dependency source files - they are separate projects -->
    <Compile Remove="Dependencies/**/*.cs" />
    <None Include="Dependencies/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference dependency projects -->
    <ProjectReference Include="Dependencies/CDTk/CDTk.csproj" />
    <ProjectReference Include="Dependencies/BADGER/Badger.csproj" />
  </ItemGroup>

</Project>
