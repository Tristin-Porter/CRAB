<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test files and generated projects from compilation -->
    <Compile Remove="Dependencies\**" />
    <Compile Remove="Testing/**/*.cs" />
    <Compile Remove="TestProject/**/*.cs" />
    <Compile Remove="testing/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="HelloWorld/**/*.cs" />
    <Compile Remove="Calculator/**/*.cs" />
    <Compile Remove="ClassHierarchy/**/*.cs" />
    <Compile Remove="GenericCollections/**/*.cs" />
    <Compile Remove="Examples/**/*.cs" />
    <Compile Remove="StandardLibrary/**/*.cs" />
    <None Include="Testing/**/*.cs" />
    <None Include="tests/**/*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Include the Testing/HelloWorld.cs file -->
    <Compile Include="Testing\HelloWorld.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Dependencies\**" />
    <None Remove="Dependencies\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Dependencies\BADGER\Badger.csproj" />
    <ProjectReference Include="Dependencies\CDTk\CDTk.csproj" />
  </ItemGroup>

</Project>
